PORT=3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://TU-CODESPACE.app.github.dev/telegram/webhook
AUTHORIZED_TELEGRAM_USER_IDS=
MODEL_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# DeepSeek: pon MODEL_PROVIDER=deepseek para conversar, planificar e implementar con él.
# La clave se obtiene en https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=120000
DEEPSEEK_AGENT_MODEL=deepseek-chat
DEEPSEEK_AGENT_MAX_STEPS=12

# Reparto de modelos: el conversacional atiende las tareas de CONVERSATIONAL_TASKS
# y el principal (MODEL_PROVIDER) se reserva para planes y código.
# Valores: gemini, deepseek, none.
CONVERSATIONAL_PROVIDER=gemini
CONVERSATIONAL_TASKS=GENERAL,ARCHITECTURE
AGENT_MEMORY_FILE=.data/agent-contexts.json
AGENT_PERSONALITY=profesional, claro, proactivo y práctico
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_TOKEN=
GITHUB_CODESPACES_TOKEN=
GITHUB_CODESPACES_MACHINE=standardLinux32gb
GITHUB_CODESPACES_NAME=
# Único lugar de trabajo del agente dentro del Codespace. Debe estar dentro de /workspaces:
# antes de cada implementación se confirma y sube el trabajo anterior y se limpia todo su contenido.
GITHUB_CODESPACES_WORKDIR=/workspaces/agent-workspace
CODESPACE_PLANNER_COMMAND=
CODESPACE_AGENT_COMMAND=
CODESPACE_COPILOT_MODEL=auto
CODESPACE_COMMAND_TIMEOUT_MS=120000
CODESPACE_PLAN_TIMEOUT_MS=240000
CODESPACE_IMPLEMENT_TIMEOUT_MS=900000
CODESPACE_REVIEW_TIMEOUT_MS=300000
CODESPACE_GIT_TIMEOUT_MS=300000

# Escritura en GitHub. Desactivada por defecto: sin esto, add/commit/push/PR fallan.
ALLOW_WRITE_OPERATIONS=false
AGENT_BRANCH_PREFIX=agent/
AGENT_COMMIT_NAME=AI Development Agent
AGENT_COMMIT_EMAIL=ai-agent@users.noreply.github.com

# Compatibilidad opcional con el adaptador WhatsApp legado.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
AUTHORIZED_WHATSAPP_NUMBERS=
